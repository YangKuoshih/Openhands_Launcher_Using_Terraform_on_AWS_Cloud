{
  "project": {
    "id": "openhands-aws-setup",
    "name": "OpenHands AWS Setup",
    "owner": "user"
  },
  "aws": {
    "region": "us-east-1",
    "instance_type": "t3.medium",
    "key_name": "openhands-key",
    "availability_zone": "us-east-1a"
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "public_subnet_cidr": "10.0.1.0/24",
    "private_subnet_cidr": "10.0.2.0/24"
  },
  "schedule": {
    "start_time": "cron(0 13 * * ? *)",
    "stop_time": "cron(0 3 * * ? *)",
    "timezone": "America/New_York"
  },
  "openhands": {
    "port": 8150,
    "version": "0.50",
    "litellm_key": "openhands-key-2025"
  }
}
